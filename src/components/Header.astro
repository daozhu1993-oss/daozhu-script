---
const { activePath = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const primary = [['/digest', '日刊'], ['/studio', '工作台']];
const library = [['/start','新手路径'],['/guides','编剧方法'],['/teardowns','拉片拆解'],['/templates','手艺模板'],['/works','原创样板'],['/about','关于岛主']];
---
<header class="mast">
  <div class="mast-inner">
    <a class="identity" href={base+'/'}><i aria-hidden="true"></i>岛主编剧工坊</a>
    <nav aria-label="主导航">
      {primary.map(([path,label]) => <a href={base+path+'/'} aria-current={activePath.startsWith(path)?'page':undefined}>{label}</a>)}
      <details class="shelves"><summary>目录</summary><div class="menu">{library.map(([path,label])=><a href={base+path+'/'}>{label}</a>)}</div></details>
    </nav>
  </div>
</header>
<style>
.mast{position:sticky;top:0;z-index:50;background:#111613;color:#f9f6e9;border-bottom:1px solid #3e413b}
.mast-inner{max-width:1320px;margin:auto;padding:0 clamp(16px,4vw,64px);height:64px;display:flex;align-items:center;justify-content:space-between;gap:8px}
.identity{display:inline-flex;align-items:center;gap:10px;font:700 clamp(17px,2vw,23px)/1.2 'Songti SC',serif;white-space:nowrap}
.identity i{display:inline-block;width:21px;height:17px;border:1px solid #dfc991;background:linear-gradient(163deg,transparent 30%,#dfc991 31% 40%,transparent 41%);transform:rotate(-5deg);border-radius:2px}
nav{display:flex;align-items:center;gap:clamp(12px,3vw,34px);font-size:14px}nav>a,summary{display:flex;align-items:center;min-height:44px}a:hover,summary:hover,a[aria-current]{color:#f4d78c}
details{position:relative}summary{cursor:pointer;list-style:none}summary::after{content:'⌄';margin-left:5px}summary::-webkit-details-marker{display:none}
.menu{position:absolute;right:0;min-width:10rem;top:100%;background:#20251f;border:1px solid #56594d;padding:6px;box-shadow:0 10px 32px #0005}.menu a{display:block;padding:10px 14px}.menu a:hover{background:#30362d}
@media(max-width:420px){.mast-inner{height:54px}nav{font-size:13px}.identity{gap:7px}}
</style>
<script>
document.querySelectorAll<HTMLDetailsElement>('.shelves').forEach(menu=>{
  document.addEventListener('click',event=>{if(!menu.contains(event.target as Node))menu.open=false});
  menu.addEventListener('keydown',event=>{if(event.key==='Escape'){menu.open=false;menu.querySelector('summary')?.focus()}});
});
</script>
