---
interface Props {
  variant?: 'compact' | 'full';
}

const { variant = 'full' } = Astro.props;
---

<div id="lead-pack" class="relative overflow-hidden rounded-3xl border-2 border-amber-500/40 bg-gradient-to-br from-cinema-900 via-cinema-900 to-amber-950/40 p-6 sm:p-9 shadow-2xl spotlight-card">
  <!-- Cinema Slate Decorative Watermark -->
  <div class="absolute -right-8 -bottom-10 text-9xl text-amber-500/5 select-none pointer-events-none font-serif" aria-hidden="true">
    🎬
  </div>

  <!-- Gold Ticket Serial Header -->
  <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 mb-5 pb-4 border-b border-amber-500/20">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30 text-xs font-semibold uppercase tracking-wider">
      <span>🎟️</span>
      <span>VIP 编剧开局手艺礼包 · 免费索取</span>
    </div>
    <div class="font-mono text-[11px] text-amber-400/80 tracking-widest hidden sm:inline">
      PASS-CODE: #2026-CINEMA-SPEC
    </div>
  </div>

  <div class="relative z-10 max-w-2xl">
    <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-snug literary-serif">
      《短剧爽点全景图 XMind》<br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-amber-300 via-amber-400 to-amber-500 bg-clip-text text-transparent">
        + 20赛道作战手册与前3集节拍表
      </span>
    </h3>

    <p class="mt-3.5 text-sm text-cinema-300 leading-relaxed font-light">
      十年编剧内部自用核心武器库。包含：完整《短剧爽点_全景图.xmind》高清源脑图、20大男女频/海外赛道爆款配方、3-30-90 节奏尺自查表、以及直接复制进 Midjourney/ComfyUI 的镜头景别 Prompt 词库。
    </p>

    <!-- Acquisition Area: WeChat Quick-Add + Copy Button -->
    <div class="mt-7 flex flex-col sm:flex-row gap-3">
      <div class="flex-1 flex items-center justify-between px-4 py-3 rounded-xl bg-cinema-950/90 border border-cinema-750 text-white text-sm shadow-inner">
        <span class="text-cinema-400 text-xs font-medium">💬 岛主个人微信：</span>
        <span class="text-amber-400 font-mono font-bold select-all text-base tracking-wider">bl-free</span>
        <span class="text-[11px] text-cinema-400 hidden sm:inline">(备注: 爽点脑图)</span>
      </div>
      <button
        type="button"
        onclick="window.copyToClipboard('bl-free', '已成功复制微信【bl-free】！请打开微信搜索添加，备注「爽点脑图」即刻索取！')"
        class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-400 via-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-cinema-950 font-extrabold text-sm transition-all shadow-lg shadow-amber-500/25 active:scale-95 shrink-0 flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>📋</span>
        <span>一键复制微信 (免费索取)</span>
      </button>
    </div>

    <!-- Verified Authenticity Trust Badges -->
    <div class="mt-5 flex flex-wrap items-center gap-5 text-xs text-cinema-400 pt-2 border-t border-cinema-850/80">
      <span class="flex items-center gap-1.5 font-medium">
        <span class="text-emerald-400 font-bold">✓</span> 配套原版 .xmind 矢量工程文件
      </span>
      <span class="flex items-center gap-1.5 font-medium">
        <span class="text-emerald-400 font-bold">✓</span> 格式涵盖 Markdown / Notion / PDF
      </span>
      <span class="flex items-center gap-1.5 font-medium">
        <span class="text-emerald-400 font-bold">✓</span> 100% 真实案头积累，无虚假套路
      </span>
    </div>
  </div>
</div>
