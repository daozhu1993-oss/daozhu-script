---
interface BeatItem {
  timing: string;
  phase: '钩子' | '压抑' | '反转' | '卡点';
  title: string;
  desc: string;
  dopamineLevel: number; // 1 to 5
}

interface Props {
  episodeName?: string;
  beats?: BeatItem[];
}

const {
  episodeName = '第一集 · 黄金留存节拍',
  beats = [
    {
      timing: '00:03 秒',
      phase: '钩子',
      title: '生死危机 / 奇观砸脸',
      desc: '拒绝慢热前戏，主角陷入绝境或遭受侮辱，迅速建立主角同情与生存欲望。',
      dopamineLevel: 4,
    },
    {
      timing: '00:30 秒',
      phase: '压抑',
      title: '绝境筑底 / 蓄势加压',
      desc: '反派施压升级，周围人冷嘲热讽，观众情绪被极度压抑，期待值拉满。',
      dopamineLevel: 2,
    },
    {
      timing: '01:10 秒',
      phase: '反转',
      title: '身份显露 / 爽点初释',
      desc: '金手指觉醒或隐藏身份反常识亮相，完成第一次情绪解压与初级打脸。',
      dopamineLevel: 5,
    },
    {
      timing: '01:45 秒',
      phase: '卡点',
      title: '断章留白 / 强扣悬念',
      desc: '在更大危机爆发的前一秒切黑屏，逼迫观众无法自拔划向下一集。',
      dopamineLevel: 4,
    },
  ],
} = Astro.props;

const phaseColors: Record<string, string> = {
  钩子: 'bg-blue-500/20 text-blue-400 border-blue-500/30',
  压抑: 'bg-purple-500/20 text-purple-400 border-purple-500/30',
  反转: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30',
  卡点: 'bg-amber-500/20 text-amber-400 border-amber-500/30',
};
---

<div class="my-6 p-5 rounded-xl bg-cinema-900 border border-cinema-750 shadow-md">
  <div class="flex items-center justify-between pb-4 mb-4 border-b border-cinema-800">
    <div class="flex items-center gap-2">
      <span class="text-amber-400 font-bold text-sm">⚡ 爽感节拍波形</span>
      <span class="text-cinema-400 text-xs">({episodeName})</span>
    </div>
    <div class="text-[11px] text-cinema-400 font-mono">
      “压抑→蓄势→爆发→反馈”闭环
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    {beats.map((beat) => (
      <div class="p-3.5 rounded-lg bg-cinema-850 border border-cinema-800 flex flex-col justify-between hover:border-cinema-700 transition-colors">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs text-cinema-400">{beat.timing}</span>
            <span class={`text-[10px] font-semibold px-2 py-0.5 rounded border ${phaseColors[beat.phase]}`}>
              {beat.phase}
            </span>
          </div>
          <h5 class="text-white text-xs font-bold mb-1.5">{beat.title}</h5>
          <p class="text-cinema-300 text-[11px] leading-relaxed">{beat.desc}</p>
        </div>
        
        <div class="mt-3 pt-2 border-t border-cinema-800/80 flex items-center justify-between text-[10px]">
          <span class="text-cinema-400">多巴胺刺激指数:</span>
          <div class="flex gap-0.5 text-amber-400">
            {Array.from({ length: 5 }).map((_, i) => (
              <span>{i < beat.dopamineLevel ? '★' : '☆'}</span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
