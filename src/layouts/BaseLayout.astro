---
import EcosystemBar from '../components/EcosystemBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const {
  title = '岛主编剧工坊 · 短剧与AI漫剧变现手艺库',
  description = '教你写出能卖、能爆的短剧/AI漫剧本子。十年职业编剧，手里有真本子，把爽感结构讲成可抄的方法。',
  activePath = '/',
} = Astro.props;

const pageTitle = title.includes('岛主编剧工坊') ? title : `${title} · 岛主编剧工坊`;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎬</text></svg>" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen bg-cinema-950 text-cinema-100 flex flex-col font-sans selection:bg-amber-500 selection:text-cinema-950">
    <EcosystemBar />
    <Header activePath={activePath} />
    
    <main class="flex-grow">
      <slot />
    </main>
    
    <Footer />

    <!-- Global Back to Top Button -->
    <button
      id="btn-back-to-top"
      type="button"
      class="fixed bottom-8 right-6 sm:right-8 z-40 p-3 rounded-2xl bg-cinema-900/90 hover:bg-cinema-800 text-amber-400 border border-cinema-700 hover:border-amber-500/50 shadow-2xl backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none translate-y-3 cursor-pointer active:scale-95 group"
      title="回到顶部"
      aria-label="回到顶部"
    >
      <svg class="w-5 h-5 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>

    <!-- Global Toast Container (Zero Alert Blocking, 100% Reliable Copy) -->
    <div id="global-toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 z-[9999] pointer-events-none transition-all duration-300 opacity-0 translate-y-4">
      <div class="px-5 py-3 rounded-2xl bg-cinema-900/95 border border-amber-500/40 text-white shadow-2xl shadow-amber-500/20 backdrop-blur-md flex items-center gap-3 text-sm font-medium">
        <span id="global-toast-icon" class="text-lg">✅</span>
        <span id="global-toast-msg" class="leading-snug">已复制到剪贴板！可在微信或文档直接粘贴！</span>
      </div>
    </div>

    <script is:inline>
      // 全局通用高可用剪贴板复制函数（支持 Modern Clipboard API 与 Safari / WebKit execCommand 降级容灾）
      window.copyToClipboard = async function(text, successMsg) {
        if (text === undefined || text === null) text = '';
        text = String(text);
        const defaultMsg = '已复制到剪贴板！可在微信或文档直接粘贴！';
        const msg = successMsg || defaultMsg;
        let success = false;

        // 策略 1: 现代 Async Clipboard API (需安全上下文)
        if (navigator.clipboard && window.isSecureContext) {
          try {
            await navigator.clipboard.writeText(text);
            success = true;
          } catch (err) {
            console.warn('navigator.clipboard.writeText 异常，启动降级策略:', err);
          }
        }

        // 策略 2: 经典 execCommand('copy') 纯同步降级方案（兼容非HTTPS、Safari、微信内置浏览器）
        if (!success) {
          try {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.setAttribute('readonly', '');
            textarea.style.position = 'fixed';
            textarea.style.top = '0';
            textarea.style.left = '-9999px';
            textarea.style.width = '2em';
            textarea.style.height = '2em';
            textarea.style.padding = '0';
            textarea.style.border = 'none';
            textarea.style.outline = 'none';
            textarea.style.boxShadow = 'none';
            textarea.style.background = 'transparent';
            document.body.appendChild(textarea);

            textarea.focus();
            textarea.select();
            textarea.setSelectionRange(0, textarea.value.length);

            success = document.execCommand('copy');
            document.body.removeChild(textarea);
          } catch (err) {
            console.error('execCommand copy 降级异常:', err);
          }
        }

        // 无论何种情况，坚决不用阻塞式的 window.alert()（避免中断 macOS/Safari 剪贴板会话）
        if (success) {
          window.showToast(msg, 'success');
        } else {
          window.showToast('自动复制受限，已为您打开复制窗口', 'warning');
          window.prompt('请手动按 Command+C (Mac) 或 Ctrl+C (Win) 复制内容：', text);
        }

        return success;
      };

      // 非阻塞优雅 Toast 提示条
      let toastTimer = null;
      window.showToast = function(message, type) {
        const toast = document.getElementById('global-toast');
        const msgEl = document.getElementById('global-toast-msg');
        const iconEl = document.getElementById('global-toast-icon');
        if (!toast || !msgEl) return;

        msgEl.innerText = message;
        if (iconEl) {
          iconEl.innerText = type === 'warning' ? '⚠️' : type === 'error' ? '❌' : '✅';
        }

        toast.classList.remove('opacity-0', 'translate-y-4');
        toast.classList.add('opacity-100', 'translate-y-0');

        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'translate-y-4');
        }, 3000);
      };

      // 全局回到顶部按钮控制
      const bttBtn = document.getElementById('btn-back-to-top');
      if (bttBtn) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) {
            bttBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
            bttBtn.classList.add('opacity-100', 'translate-y-0');
          } else {
            bttBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
            bttBtn.classList.remove('opacity-100', 'translate-y-0');
          }
        });
        bttBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // 兼容 GitHub Pages 子路径 (/daozhu-script) 自动前缀路由补全
      if (window.location.hostname.includes('github.io') && window.location.pathname.startsWith('/daozhu-script')) {
        document.addEventListener('click', (e) => {
          const a = e.target.closest('a');
          if (a) {
            const href = a.getAttribute('href');
            if (href && href.startsWith('/') && !href.startsWith('//') && !href.startsWith('/daozhu-script')) {
              e.preventDefault();
              window.location.href = '/daozhu-script' + href;
            }
          }
        });
      }
    </script>
  </body>
</html>
