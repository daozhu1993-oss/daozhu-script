---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const teardowns = await getCollection('teardowns');
---

<BaseLayout activePath="/teardowns" title="拆爆款 · 岛主编剧工坊">
  <section class="pt-12 pb-16 px-4 sm:px-6 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="max-w-2xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 text-xs font-mono mb-3">
        🔬 BREAKDOWNS & REVERSE ENGINEERING
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight literary-serif">
        爆款短剧与漫剧拉片拆解
      </h1>
      <p class="mt-3 text-sm sm:text-base text-cinema-300 leading-relaxed">
        用编剧的解剖刀拆解爆款。不写情绪化影评，只拆：爽点在第几分钟、钩子怎么下的、压抑怎么蓄势的。给你 3-5 条明天就能抄的手艺。
      </p>
    </div>

    <!-- Teardowns List -->
    <div class="space-y-8">
      {teardowns.map((item) => (
        <article class="p-6 sm:p-7 rounded-2xl bg-cinema-900 border border-cinema-800 hover:border-amber-500/40 hover:bg-cinema-850/70 transition-all flex flex-col md:flex-row gap-6 shadow-xl">
          <!-- Poster Column -->
          <div class="w-full md:w-52 sm:w-60 shrink-0">
            <a href={`/teardowns/${item.slug}`} class="block aspect-[3/4] rounded-xl overflow-hidden bg-cinema-950 border border-cinema-800 relative group shadow-md">
              {item.data.poster ? (
                <img
                  src={item.data.poster}
                  alt={item.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-4xl">🎬</div>
              )}
              <div class="absolute top-2 left-2 px-2 py-0.5 rounded bg-cinema-950/80 text-[10px] font-bold text-amber-400 border border-amber-500/30 backdrop-blur-sm">
                {item.data.format}
              </div>
            </a>
          </div>

          <!-- Content Column -->
          <div class="flex-1 flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-2.5">
                <span class="text-xs font-mono text-cinema-400">
                  {item.data.genre}
                </span>
                <span class="text-cinema-700">·</span>
                <span class="text-xs font-mono text-amber-400/90">
                  {item.data.episodesOrDuration}
                </span>
              </div>

              <h2 class="text-xl sm:text-2xl font-bold text-white mb-3 hover:text-amber-400 transition-colors literary-serif">
                <a href={`/teardowns/${item.slug}`}>
                  {item.data.title}
                </a>
              </h2>

              <div class="p-3.5 rounded-xl bg-cinema-950 border border-cinema-800 text-xs text-cinema-300 mb-4">
                <span class="text-amber-400 font-bold block mb-1">⚡ 黄金进场钩子:</span>
                <span class="leading-relaxed">{item.data.hookTiming}</span>
              </div>

              <p class="text-sm text-cinema-300 leading-relaxed mb-4">
                {item.data.structureSummary}
              </p>

              <!-- Takeaways Preview -->
              <div class="space-y-1.5 pt-3 border-t border-cinema-800/60">
                <span class="text-[11px] font-mono text-cinema-400 block mb-1">核心可抄手艺:</span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  {item.data.takeaways.map((point) => (
                    <div class="text-xs text-cinema-300 flex items-start gap-1.5">
                      <span class="text-emerald-400 font-bold">✓</span>
                      <span class="line-clamp-1">{point}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-cinema-800/80 flex items-center justify-between text-xs">
              <span class="text-cinema-400 font-mono">十年编剧拉片档案 · 工业级视角</span>
              <a href={`/teardowns/${item.slug}`} class="text-amber-400 font-bold hover:underline flex items-center gap-1">
                阅读完整解剖与节奏波形 ➔
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
