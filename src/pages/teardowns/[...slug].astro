---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BeatVisualizer from '../../components/BeatVisualizer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const teardowns = await getCollection('teardowns');
  return teardowns.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prevTeardown: index > 0 ? teardowns[index - 1] : null,
      nextTeardown: index < teardowns.length - 1 ? teardowns[index + 1] : null,
    },
  }));
}

const { entry, prevTeardown, nextTeardown } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout activePath="/teardowns" title={`${entry.data.title} · 爆款拆解`}>
  <!-- Reading Progress Bar -->
  <div id="read-progress-bar" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-blue-500 to-amber-400 z-50 transition-all duration-150 w-0"></div>

  <article class="pt-10 pb-20 px-4 sm:px-6 max-w-4xl mx-auto">
    <!-- Back button & Meta breadcrumb -->
    <div class="flex items-center justify-between mb-6 text-xs font-mono">
      <a href="/teardowns" class="text-cinema-400 hover:text-blue-400 inline-flex items-center gap-1 transition-colors">
        ← 返回爆款拆解列表
      </a>
      <span class="text-cinema-500">
        十年正规军工业解剖刀
      </span>
    </div>

    <!-- Header info with Poster -->
    <header class="pb-8 border-b border-cinema-800">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        <!-- Poster Thumbnail -->
        {entry.data.poster && (
          <div class="w-full md:w-56 shrink-0 rounded-2xl overflow-hidden shadow-2xl border border-cinema-800 bg-cinema-900 group">
            <img
              src={entry.data.poster}
              alt={entry.data.title}
              class="w-full h-auto object-cover aspect-[3/4] group-hover:scale-102 transition-transform duration-500"
            />
          </div>
        )}

        <!-- Meta and Title -->
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
              {entry.data.format}
            </span>
            <span class="text-xs font-mono text-cinema-300 bg-cinema-900 px-2 py-0.5 rounded border border-cinema-800">
              {entry.data.episodesOrDuration}
            </span>
            <span class="text-xs text-cinema-400">
              类型：{entry.data.genre}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-snug literary-serif mb-4">
            {entry.data.title}
          </h1>

          <!-- Hook & Structure callout -->
          <div class="grid grid-cols-1 gap-3">
            <div class="p-3.5 rounded-xl bg-cinema-900 border border-cinema-800">
              <span class="text-amber-400 font-bold text-xs uppercase tracking-wider block mb-1">
                ⚡ 核心进场钩子
              </span>
              <p class="text-xs sm:text-sm text-cinema-200">
                {entry.data.hookTiming}
              </p>
            </div>
            <div class="p-3.5 rounded-xl bg-cinema-900 border border-cinema-800">
              <span class="text-blue-400 font-bold text-xs uppercase tracking-wider block mb-1">
                🏗️ 架构特点
              </span>
              <p class="text-xs sm:text-sm text-cinema-200">
                {entry.data.structureSummary}
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Takeaways summary pill -->
      <div class="mt-6 p-4 rounded-xl bg-emerald-950/20 border border-emerald-500/30">
        <h4 class="text-emerald-400 text-xs font-bold uppercase tracking-wider mb-2">
          🎯 本期可直接复用的 4 大编剧手艺:
        </h4>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-cinema-300">
          {entry.data.takeaways.map((point) => (
            <li class="flex items-start gap-1.5">
              <span class="text-emerald-400 font-bold">✓</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <!-- Visualizer Component with Real Custom Beats -->
    <div class="mt-8">
      <BeatVisualizer
        episodeName={`${entry.data.title} · 真实秒级节奏解剖`}
        beats={entry.data.beats}
      />
    </div>

    <!-- Markdown Article Content -->
    <div class="prose prose-invert max-w-none mt-8 text-cinema-200 leading-loose space-y-6 text-sm sm:text-base">
      <Content />
    </div>

    <!-- Cross-Link Toolbox -->
    <div class="mt-14 p-6 rounded-2xl bg-cinema-900/80 border border-cinema-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1">
        <h4 class="text-sm font-bold text-white flex items-center gap-2">
          <span>⚙️</span> 想要实战跑出同款节奏？
        </h4>
        <p class="text-xs text-cinema-400">
          去在线工作台套用 90 秒四相位节拍器，或直接在模板库复制开局脚手架。
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/studio"
          class="px-3.5 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-bold transition-colors"
        >
          打开工作台实操 ➔
        </a>
        <a
          href="/templates"
          class="px-3.5 py-2 rounded-xl bg-cinema-800 hover:bg-cinema-700 text-cinema-200 text-xs font-medium transition-colors"
        >
          查看模板库
        </a>
      </div>
    </div>

    <!-- Bottom Navigation (Prev / Next) -->
    <div class="mt-10 pt-6 border-t border-cinema-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-medium">
      {prevTeardown ? (
        <a
          href={`/teardowns/${prevTeardown.slug}`}
          class="w-full sm:w-auto p-3 rounded-xl bg-cinema-900 hover:bg-cinema-850 border border-cinema-800 hover:border-blue-500/30 text-cinema-300 hover:text-white transition-all flex items-center gap-2"
        >
          <span class="text-blue-400">←</span>
          <div class="text-left">
            <span class="text-[10px] text-cinema-400 block font-mono">上一篇拆解</span>
            <span class="font-bold line-clamp-1">{prevTeardown.data.title}</span>
          </div>
        </a>
      ) : (
        <div class="hidden sm:block"></div>
      )}

      <a href="/teardowns" class="text-cinema-400 hover:text-blue-400 font-mono text-center">
        查看全部拆解 ➔
      </a>

      {nextTeardown ? (
        <a
          href={`/teardowns/${nextTeardown.slug}`}
          class="w-full sm:w-auto p-3 rounded-xl bg-cinema-900 hover:bg-cinema-850 border border-cinema-800 hover:border-blue-500/30 text-cinema-300 hover:text-white transition-all flex items-center justify-end gap-2 text-right"
        >
          <div class="text-right">
            <span class="text-[10px] text-cinema-400 block font-mono">下一篇拆解</span>
            <span class="font-bold line-clamp-1">{nextTeardown.data.title}</span>
          </div>
          <span class="text-blue-400">→</span>
        </a>
      ) : (
        <div class="hidden sm:block"></div>
      )}
    </div>
  </article>

  <!-- Reading Progress Script -->
  <script is:inline>
    window.addEventListener('scroll', () => {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
      const bar = document.getElementById('read-progress-bar');
      if (bar) {
        bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      }
    });
  </script>
</BaseLayout>
