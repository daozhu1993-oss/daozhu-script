---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout activePath="/guides" title={`${entry.data.title} · 方法论库`}>
  <article class="pt-10 pb-20 px-4 sm:px-6 max-w-4xl mx-auto">
    <!-- Back button -->
    <a href="/guides" class="text-xs font-mono text-cinema-400 hover:text-amber-400 mb-6 inline-flex items-center gap-1">
      ← 返回方法论库列表
    </a>

    <!-- Header info -->
    <header class="pb-8 border-b border-cinema-800">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
          {entry.data.topic}
        </span>
        <span class="text-xs text-cinema-400 font-mono">
          难度: {entry.data.level} · 阅读时间: {entry.data.readTime}
        </span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug literary-serif">
        {entry.data.title}
      </h1>
      <p class="mt-4 text-sm sm:text-base text-cinema-300 leading-relaxed bg-cinema-900/80 p-4 rounded-xl border border-cinema-800">
        💡 <strong>本篇核心提要</strong>：{entry.data.summary}
      </p>
    </header>

    <!-- Markdown Article Content -->
    <div class="prose prose-invert max-w-none mt-10 text-cinema-200 leading-loose space-y-6 text-sm sm:text-base">
      <Content />
    </div>

    <!-- Article Footer CTA -->
    <div class="mt-16 pt-8 border-t border-cinema-800 bg-cinema-900/60 p-6 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="text-white font-bold text-sm">学完了想要马上实操？</h4>
        <p class="text-xs text-cinema-400 mt-1">下载岛主同款标准脚手架与分镜节拍卡，省去 90% 排版排表时间。</p>
      </div>
      <a href="/templates" class="px-5 py-2.5 rounded-xl bg-amber-500 text-cinema-950 font-bold text-xs shrink-0 hover:bg-amber-400 transition-colors shadow-sm">
        前往模板工具库 ➔
      </a>
    </div>
  </article>
</BaseLayout>
