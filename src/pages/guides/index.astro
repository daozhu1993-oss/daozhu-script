---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const sortedGuides = guides.sort((a, b) => a.data.order - b.data.order);

const topics = [
  '全部',
  '付费点剧作学',
  '结构与节奏',
  '爽感公式',
  '留人与钩子',
  '人物与人设',
  'AI漫剧工作流',
  '平台与过审',
];
---

<BaseLayout activePath="/guides" title="方法论库 · 岛主编剧工坊">
  <section class="pt-12 pb-16 px-4 sm:px-6 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="max-w-2xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-mono mb-3">
        📖 EVERGREEN KNOWLEDGE BASE
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight literary-serif">
        短剧与 AI 漫剧方法论库
      </h1>
      <p class="mt-3 text-sm sm:text-base text-cinema-300 leading-relaxed">
        不按发布日期，按知识体系组织。十年职业编剧把底层结构、爽感节拍、留人钩子讲透，一次写好，长期复用。
      </p>
    </div>

    <!-- Topic Badges Filter (Static) -->
    <div class="flex flex-wrap gap-2 pb-8 border-b border-cinema-800/80 mb-8">
      {topics.map((topic, i) => (
        <span
          class:list={[
            'px-3.5 py-1.5 rounded-lg text-xs font-medium cursor-pointer transition-colors',
            i === 0
              ? 'bg-amber-500 text-cinema-950 font-bold shadow-sm'
              : 'bg-cinema-900 text-cinema-300 hover:text-white hover:bg-cinema-850 border border-cinema-800',
          ]}
        >
          {topic}
        </span>
      ))}
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedGuides.map((guide) => (
        <article class="p-6 rounded-2xl bg-cinema-900 border border-cinema-800 hover:border-amber-500/40 hover:bg-cinema-850/60 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2.5 mb-3">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
                {guide.data.topic}
              </span>
              <span class="text-xs text-cinema-400 font-mono">
                {guide.data.level} · 预计阅读 {guide.data.readTime}
              </span>
            </div>
            <h2 class="text-lg font-bold text-white mb-2.5 hover:text-amber-400 transition-colors">
              <a href={`/guides/${guide.slug}`}>
                {guide.data.title}
              </a>
            </h2>
            <p class="text-sm text-cinema-300 leading-relaxed">
              {guide.data.summary}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-cinema-800/80 flex items-center justify-between text-xs">
            <span class="text-cinema-400 font-mono">手艺更新 · {guide.data.updated}</span>
            <a href={`/guides/${guide.slug}`} class="text-amber-400 font-medium hover:underline flex items-center gap-1">
              进入深度学习 ➔
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
