---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadMagnetCard from '../../components/LeadMagnetCard.astro';
import { getCollection } from 'astro:content';

const templates = await getCollection('templates');
const sortedTemplates = templates.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout activePath="/templates" title="模板与工具库 · 岛主编剧工坊">
  <section class="pt-12 pb-16 px-4 sm:px-6 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="max-w-2xl mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-mono mb-3">
        🧰 SCRIPTWRITING ARSENAL
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight literary-serif">
        生产力模板 & 工具库
      </h1>
      <p class="mt-3 text-sm sm:text-base text-cinema-300 leading-relaxed">
        告别从零手搓。提供十年一线编剧自用的工业化脚手架：分集断章节奏卡、人物欲望冲突表、以及直接复制进绘图工具的 Prompt 字典。
      </p>
    </div>

    <!-- Lead Magnet Banner for Email / Pack -->
    <div class="mb-14">
      <LeadMagnetCard />
    </div>

    <!-- Templates Grid -->
    <div class="space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-cinema-800">
        <h3 class="text-lg font-bold text-white">
          📦 精选模板与脚手架卡片
        </h3>
        <span class="text-xs text-cinema-400">持续更新 · 支持一键复制</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {sortedTemplates.map(async (tpl) => {
          const { Content } = await tpl.render();
          return (
            <div class="p-6 rounded-2xl bg-cinema-900 border border-cinema-800 hover:border-emerald-500/40 transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    {tpl.data.type}
                  </span>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono text-cinema-400">
                      {tpl.data.fileFormat}
                    </span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 uppercase">
                      {tpl.data.access === 'free' ? '免费' : tpl.data.access === 'email' ? '换邮箱' : 'PRO'}
                    </span>
                  </div>
                </div>

                <h4 class="text-lg font-bold text-white mb-2">
                  {tpl.data.title}
                </h4>

                <p class="text-xs text-cinema-300 mb-4 leading-relaxed">
                  {tpl.data.description}
                </p>

                <div class="p-3 rounded-xl bg-cinema-950/80 border border-cinema-800 text-xs text-amber-300 mb-4 flex items-start gap-2">
                  <span>💡</span>
                  <span>{tpl.data.highlight}</span>
                </div>

                <!-- Markdown Content Snippet inside -->
                <div class="p-4 rounded-xl bg-cinema-950 border border-cinema-850 text-xs text-cinema-200 overflow-x-auto max-h-56 overflow-y-auto font-mono">
                  <Content />
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-cinema-800/80 flex items-center justify-between">
                <a
                  href={`/templates/${tpl.slug}`}
                  class="text-xs text-amber-400 font-bold hover:underline flex items-center gap-1"
                >
                  <span>阅读完整版 / 脑图</span>
                  <span>➔</span>
                </a>
                <button
                  type="button"
                  onclick="alert('已复制该模板脚手架到剪贴板！你也可以在上方获取完整高清工程文件包。')"
                  class="px-3.5 py-1.5 rounded-xl bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30 border border-emerald-500/40 text-xs font-bold transition-all flex items-center gap-1.5"
                >
                  <span>📋</span>
                  <span>复制模板</span>
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
