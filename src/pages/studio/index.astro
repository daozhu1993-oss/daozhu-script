---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="创作工作台 · 90秒分集节拍与小说改短剧工具"
  description="基于十年职业影视编剧四相位节拍系统。拒绝市面 AI 软件的假大空台词，一键生成工业级短剧大纲、小说切片剧本与 DeepSeek/GPT 提示词。"
  activePath="/studio"
>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <!-- Header -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-400 text-xs font-mono mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
        <span>工业级实操工具 · 纯前端零隐私泄露</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight literary-serif mb-4">
        岛主在线编剧工作台
      </h1>
      <p class="text-base sm:text-lg text-cinema-300 leading-relaxed">
        拒绝市面 AI 软件的流水账水货台词。输入你的故事种子，直接套用 <strong class="text-amber-400">10 年影视正规军的四相位节拍系统</strong>，一键生成过审率极高的分集剧本与工业 Prompt。
      </p>
    </div>

    <!-- Interactive Studio Container -->
    <div class="bg-cinema-900 border border-cinema-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden" id="studio-app">
      <!-- Glow ambient -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Tab Switcher -->
      <div class="flex flex-wrap gap-2 sm:gap-3 p-1.5 bg-cinema-950 rounded-2xl border border-cinema-800 mb-8 max-w-2xl mx-auto">
        <button
          type="button"
          class="tab-btn flex-1 py-3 px-4 rounded-xl text-xs sm:text-sm font-bold transition-all text-center flex items-center justify-center gap-2 active-tab bg-amber-500 text-cinema-950 shadow-lg shadow-amber-500/20"
          data-tab="beat-gen"
        >
          <span>⚡ 90秒分集节拍器</span>
        </button>
        <button
          type="button"
          class="tab-btn flex-1 py-3 px-4 rounded-xl text-xs sm:text-sm font-bold transition-all text-center flex items-center justify-center gap-2 text-cinema-400 hover:text-white hover:bg-cinema-900"
          data-tab="novel-slice"
        >
          <span>📖 小说转短剧切片</span>
        </button>
        <button
          type="button"
          class="tab-btn flex-1 py-3 px-4 rounded-xl text-xs sm:text-sm font-bold transition-all text-center flex items-center justify-center gap-2 text-cinema-400 hover:text-white hover:bg-cinema-900"
          data-tab="char-matrix"
        >
          <span>🎭 角色对立张力表</span>
        </button>
      </div>

      <!-- TAB 1: 90秒短剧分集节拍发生器 -->
      <div id="tab-beat-gen" class="tab-pane space-y-6">
        <!-- Quick Presets -->
        <div class="flex flex-wrap items-center gap-2 pt-1 pb-2 text-xs">
          <span class="text-cinema-400 font-mono">⚡ 极速预设填入:</span>
          <button type="button" class="preset-btn px-2.5 py-1 rounded-lg bg-cinema-800 hover:bg-amber-500/20 text-cinema-200 hover:text-amber-400 border border-cinema-700 transition-colors" data-preset="wushuang">
            男频战神 · 《无双》式逆风局
          </button>
          <button type="button" class="preset-btn px-2.5 py-1 rounded-lg bg-cinema-800 hover:bg-amber-500/20 text-cinema-200 hover:text-amber-400 border border-cinema-700 transition-colors" data-preset="houma">
            女频年代 · 《八零后妈》打脸爽局
          </button>
          <button type="button" class="preset-btn px-2.5 py-1 rounded-lg bg-cinema-800 hover:bg-amber-500/20 text-cinema-200 hover:text-amber-400 border border-cinema-700 transition-colors" data-preset="taochu">
            AI漫剧/国风 · 《出逃文物》拟人羁绊
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Left: Inputs -->
          <div class="space-y-4">
            <div>
              <label class="block text-xs font-mono text-cinema-300 mb-1.5">剧作项目名称 (Title)</label>
              <input type="text" id="beat-title" class="w-full px-3.5 py-2.5 rounded-xl bg-cinema-950 border border-cinema-800 text-sm text-white focus:outline-none focus:border-amber-400" placeholder="例如：重生之狂飙龙王" value="隐龙归渊" />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-mono text-cinema-300 mb-1.5">题材流派 (Genre)</label>
                <select id="beat-genre" class="w-full px-3.5 py-2.5 rounded-xl bg-cinema-950 border border-cinema-800 text-sm text-white focus:outline-none focus:border-amber-400">
                  <option value="男频战神/逆袭打脸">男频战神/逆袭打脸</option>
                  <option value="女频年代/爽利后妈">女频年代/爽利后妈</option>
                  <option value="豪门甜宠/契约打脸">豪门甜宠/契约打脸</option>
                  <option value="国风奇幻/AI漫剧">国风奇幻/AI漫剧</option>
                  <option value="银发亲情/反诈复仇">银发亲情/反诈复仇</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-mono text-cinema-300 mb-1.5">集数定位</label>
                <input type="text" id="beat-ep" class="w-full px-3.5 py-2.5 rounded-xl bg-cinema-950 border border-cinema-800 text-sm text-white focus:outline-none focus:border-amber-400" value="第 1 集（黄金开局卡）" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-mono text-cinema-300 mb-1.5">主角身份与表面弱点 (Protagonist & Flaw)</label>
              <input type="text" id="beat-protag" class="w-full px-3.5 py-2.5 rounded-xl bg-cinema-950 border border-cinema-800 text-sm text-white focus:outline-none focus:border-amber-400" placeholder="例如：隐姓埋名的科研总工，表面是个修车工" value="隐姓埋名的国级统帅，表面是个落魄的外卖员" />
            </div>

            <div>
              <label class="block text-xs font-mono text-cinema-300 mb-1.5">核心压迫源/第一反派 (Antagonist)</label>
              <input type="text" id="beat-antag" class="w-full px-3.5 py-2.5 rounded-xl bg-cinema-950 border border-cinema-800 text-sm text-white focus:outline-none focus:border-amber-400" placeholder="例如：霸占家产的恶毒大嫂" value="势利岳母与跨国集团纨绔少爷" />
            </div>

            <div>
              <label class="block text-xs font-mono text-cinema-300 mb-1.5">开局第一危机事件 (The Hook Event)</label>
              <input type="text" id="beat-crisis" class="w-full px-3.5 py-2.5 rounded-xl bg-cinema-950 border border-cinema-800 text-sm text-white focus:outline-none focus:border-amber-400" placeholder="例如：女儿救命手术费被反派撕毁" value="在五星级酒店宴会厅，反派当众将主角母亲的救命骨灰盒踢翻踩在脚下" />
            </div>

            <div>
              <label class="block text-xs font-mono text-cinema-300 mb-1.5">隐藏王牌/反转伏笔 (Ace Card)</label>
              <input type="text" id="beat-ace" class="w-full px-3.5 py-2.5 rounded-xl bg-cinema-950 border border-cinema-800 text-sm text-white focus:outline-none focus:border-amber-400" placeholder="例如：手机突然收到全球银行解冻提示" value="主角随身携带的加密卫星电话突然响起，军部九大元老全员起立待命" />
            </div>

            <button type="button" id="btn-generate-beat" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-cinema-950 font-bold text-sm shadow-xl shadow-amber-500/20 active:scale-[0.98] transition-all flex items-center justify-center gap-2">
              <span id="btn-beat-text">⚡ 一键生成 90秒分集节拍与工业台本</span>
            </button>
          </div>

          <!-- Right: Output Preview with Multi-View Subtabs -->
          <div id="beat-output-container" class="flex flex-col justify-between rounded-2xl bg-cinema-950 border border-cinema-800 p-5 relative min-h-[520px] transition-all duration-300">
            <div>
              <!-- Output Subtabs Header -->
              <div class="flex flex-wrap items-center justify-between pb-3 border-b border-cinema-800 mb-3 gap-2">
                <div class="flex items-center gap-1 p-0.5 rounded-lg bg-cinema-900 border border-cinema-800 text-xs font-mono">
                  <button type="button" id="subtab-script" class="px-2.5 py-1 rounded-md bg-amber-500 text-cinema-950 font-bold transition-all">
                    🎬 工业分集台本
                  </button>
                  <button type="button" id="subtab-beat" class="px-2.5 py-1 rounded-md text-cinema-400 hover:text-white transition-all">
                    ⚡ 4相位节拍表
                  </button>
                  <button type="button" id="subtab-prompt" class="px-2.5 py-1 rounded-md text-cinema-400 hover:text-white transition-all">
                    🤖 工业级 Prompt
                  </button>
                </div>

                <button type="button" id="btn-copy-current" class="text-xs font-mono px-3 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 transition-colors flex items-center gap-1 active:scale-95">
                  <span id="btn-copy-label">📋 一键复制当前内容</span>
                </button>
              </div>

              <!-- Generation Success Notification Badge -->
              <div id="gen-status-badge" class="hidden mb-3 p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-xs text-emerald-400 flex items-center justify-between transition-all">
                <span class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                  <span id="gen-status-text" class="font-medium">已成功生成第 1 集 90 秒工业级分集台本与节拍！</span>
                </span>
                <span class="text-[10px] text-emerald-500 font-mono">0.3s 耗时</span>
              </div>

              <!-- View 1: 完整工业台本 (Default) -->
              <div id="view-script" class="space-y-2 text-xs font-mono text-cinema-200">
                <pre id="script-full-content" class="whitespace-pre-wrap font-mono p-4 rounded-xl bg-cinema-900/90 border border-cinema-800 max-h-[440px] overflow-y-auto leading-relaxed"></pre>
              </div>

              <!-- View 2: 四相位节拍表 -->
              <div id="view-beat" class="hidden space-y-3 text-xs text-cinema-200">
                <div id="beat-output-content" class="space-y-3"></div>
              </div>

              <!-- View 3: 工业级 Prompt -->
              <div id="view-prompt" class="hidden space-y-2.5 text-xs font-mono text-cinema-200">
                <div class="p-3 rounded-xl bg-cinema-900/90 border border-cinema-800 space-y-1">
                  <span class="text-amber-400 font-bold block">💡 使用说明：</span>
                  <p class="text-cinema-400 leading-relaxed text-[11px]">
                    直接将下方 Prompt 复制并粘贴至 DeepSeek-R1 / ChatGPT / 豆包 等大模型窗口中发送，即可按正规军标准扩写。
                  </p>
                </div>
                <pre id="prompt-output-content" class="whitespace-pre-wrap font-mono p-3.5 rounded-xl bg-cinema-900/90 border border-cinema-800 text-cinema-300 max-h-[360px] overflow-y-auto leading-relaxed"></pre>
              </div>
            </div>

            <!-- Bottom Note -->
            <div class="pt-3 border-t border-cinema-800 mt-4 flex items-center justify-between text-[11px] text-cinema-400 font-mono">
              <span>⚡ 纯前端运算 · 零后台传输 · 保护编剧原创机密</span>
              <span class="text-amber-400/80">四相位节拍体系</span>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 2: 小说转短剧切片器 -->
      <div id="tab-novel-slice" class="tab-pane hidden space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
          <span class="text-cinema-400 font-mono">📖 载入经典小说切片范例：</span>
          <div class="flex gap-2">
            <button type="button" class="novel-demo-btn px-2.5 py-1 rounded-lg bg-cinema-800 hover:bg-amber-500/20 text-cinema-200 hover:text-amber-400 border border-cinema-700 transition-colors" data-demo="urban">
              都市战神网文片段
            </button>
            <button type="button" class="novel-demo-btn px-2.5 py-1 rounded-lg bg-cinema-800 hover:bg-amber-500/20 text-cinema-200 hover:text-amber-400 border border-cinema-700 transition-colors" data-demo="period">
              年代女频后妈片段
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- Input -->
          <div class="space-y-4">
            <div>
              <label class="block text-xs font-mono text-cinema-300 mb-1.5">粘贴小说原文 (500~2000字)</label>
              <textarea id="novel-input" rows="12" class="w-full px-3.5 py-3 rounded-xl bg-cinema-950 border border-cinema-800 text-xs text-cinema-200 font-mono leading-relaxed focus:outline-none focus:border-amber-400" placeholder="在此粘贴小说章节，系统将自动进行：
1. 剥离冗余心理描写与旁白
2. 提取极端对立动作与道具
3. 重构成符合 90 秒黄金切片的专业剧本格式..."></textarea>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-mono text-cinema-300 mb-1.5">视听转换模式</label>
                <select id="novel-mode" class="w-full px-3 py-2 rounded-xl bg-cinema-950 border border-cinema-800 text-xs text-white">
                  <option value="fast">90秒高压断章切片 (快节奏微短剧)</option>
                  <option value="manga">分镜头Prompt参数注入 (AI漫剧)</option>
                  <option value="dialogue">台词刀刃去水化 (纯对白提取)</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-mono text-cinema-300 mb-1.5">节奏强度</label>
                <select class="w-full px-3 py-2 rounded-xl bg-cinema-950 border border-cinema-800 text-xs text-white">
                  <option>极度紧凑（3秒一冲突）</option>
                  <option>情绪递进（悬疑拉扯）</option>
                </select>
              </div>
            </div>

            <button type="button" id="btn-slice-novel" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-400 hover:to-indigo-500 text-white font-bold text-sm shadow-xl shadow-blue-500/20 transition-all flex items-center justify-center gap-2">
              <span>🎬 运行影视化脱水切片</span>
            </button>
          </div>

          <!-- Output -->
          <div class="flex flex-col justify-between rounded-2xl bg-cinema-950 border border-cinema-800 p-5 relative min-h-[460px]">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-cinema-800 mb-3">
                <span class="text-xs font-mono text-blue-400 font-bold flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-blue-400"></span> 影视标准剧本排版 (Screenplay Format)
                </span>
                <button type="button" id="btn-copy-script" class="text-xs font-mono px-2.5 py-1 rounded bg-cinema-850 hover:bg-blue-500/20 text-cinema-300 hover:text-blue-400 border border-cinema-700 transition-colors">
                  📋 复制剧本
                </button>
              </div>

              <div id="script-output-content" class="text-xs text-cinema-200 font-mono whitespace-pre-wrap leading-relaxed max-h-[380px] overflow-y-auto">
                <div class="text-center text-cinema-500 py-16">
                  👈 请在左侧粘贴小说内容，或点击上方“载入示例”，然后点击运行脱水切片
                </div>
              </div>
            </div>

            <div class="pt-3 border-t border-cinema-800 mt-4 flex items-center justify-between text-[11px] text-cinema-400">
              <span>💡 提示：本剧本已自动符合广电微短剧备案审查规范</span>
              <a href="/templates" class="text-blue-400 hover:underline">获取更多专业模板 ➔</a>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: 角色对立张力表 -->
      <div id="tab-char-matrix" class="tab-pane hidden space-y-6">
        <div class="p-4 rounded-2xl bg-cinema-950 border border-cinema-800 text-xs text-cinema-300 leading-relaxed">
          <strong class="text-amber-400">十年编剧心法：</strong> 短剧不写“好人对坏人”，只写“极致欲望对极致剥夺”。主角越隐忍、反派踩得越狠，反转瞬间的多巴胺喷发量才越高。
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <!-- Col 1: Protagonist -->
          <div class="p-5 rounded-2xl bg-cinema-950 border border-cinema-800 space-y-4">
            <h3 class="text-sm font-bold text-amber-400 flex items-center gap-1.5 font-mono">
              👤 主角核心维度 (Protagonist)
            </h3>
            <div>
              <label class="block text-[11px] font-mono text-cinema-400 mb-1">表面卑微身份</label>
              <input type="text" id="char-protag-job" class="w-full px-3 py-2 rounded-lg bg-cinema-900 border border-cinema-800 text-xs text-white" value="被逐出家门的养子 / 穷困潦倒的修表匠" />
            </div>
            <div>
              <label class="block text-[11px] font-mono text-cinema-400 mb-1">终极不可剥夺欲望</label>
              <input type="text" id="char-protag-want" class="w-full px-3 py-2 rounded-lg bg-cinema-900 border border-cinema-800 text-xs text-white" value="查明父母车祸真相，夺回祖传秘方" />
            </div>
            <div>
              <label class="block text-[11px] font-mono text-cinema-400 mb-1">致命软肋/保护对象</label>
              <input type="text" id="char-protag-weak" class="w-full px-3 py-2 rounded-lg bg-cinema-900 border border-cinema-800 text-xs text-white" value="患重症需要巨额医药费的妹妹" />
            </div>
          </div>

          <!-- Col 2: Antagonist -->
          <div class="p-5 rounded-2xl bg-cinema-950 border border-cinema-800 space-y-4">
            <h3 class="text-sm font-bold text-rose-400 flex items-center gap-1.5 font-mono">
              🦹 反派压迫维度 (Antagonist)
            </h3>
            <div>
              <label class="block text-[11px] font-mono text-cinema-400 mb-1">垄断资源/优势权力</label>
              <input type="text" id="char-antag-power" class="w-full px-3 py-2 rounded-lg bg-cinema-900 border border-cinema-800 text-xs text-white" value="商会副会长 / 握有医药批文与全市渠道" />
            </div>
            <div>
              <label class="block text-[11px] font-mono text-cinema-400 mb-1">剥夺手段/折辱行为</label>
              <input type="text" id="char-antag-action" class="w-full px-3 py-2 rounded-lg bg-cinema-900 border border-cinema-800 text-xs text-white" value="停掉妹妹的重症监护仪器，逼主角当下学狗叫" />
            </div>
            <div>
              <label class="block text-[11px] font-mono text-cinema-400 mb-1">虚伪面具特征</label>
              <input type="text" id="char-antag-mask" class="w-full px-3 py-2 rounded-lg bg-cinema-900 border border-cinema-800 text-xs text-white" value="表面慈善家，私下放高利贷与器官交易" />
            </div>
          </div>

          <!-- Col 3: Climax Explosion -->
          <div class="p-5 rounded-2xl bg-cinema-950 border border-cinema-800 space-y-4">
            <h3 class="text-sm font-bold text-emerald-400 flex items-center gap-1.5 font-mono">
              💥 戏剧张力与核爆反制
            </h3>
            <div class="p-3.5 rounded-xl bg-cinema-900 border border-cinema-800 text-xs space-y-2">
              <span class="text-amber-400 font-bold block">⚡ 核心反讽契机 (Dramatic Irony):</span>
              <p class="text-cinema-300 leading-relaxed">
                反派正在巴结的大财阀特使，正是主角当年的部下；反派用来踩灭主角的协议，实际上需要主角的私人印鉴才能生效。
              </p>
            </div>
            <div class="p-3.5 rounded-xl bg-cinema-900 border border-cinema-800 text-xs space-y-2">
              <span class="text-emerald-400 font-bold block">🎯 打脸名场面 (Payoff Beat):</span>
              <p class="text-cinema-300 leading-relaxed">
                在全城名流云集的签约仪式上，特使当着所有媒体的面径直绕过反派，向角落里穿外卖服的主角单膝跪地奉上印鉴。
              </p>
            </div>
            <button type="button" id="btn-copy-matrix" class="w-full py-2.5 px-4 rounded-xl bg-cinema-900 hover:bg-cinema-850 text-cinema-200 border border-cinema-700 text-xs font-mono transition-colors">
              📋 复制角色冲突卡
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Handcrafted Resources Callout -->
