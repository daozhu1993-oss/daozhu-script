            // Fallback to smart local parser
            const fallbackScript = smartParseNovelToScript(text, mode);
            document.getElementById('script-output-content').innerText = `[提示: API 连接失败 (${err.message})，已自动切换为本地智能脱水引擎生成]\n\n` + fallbackScript;
          }
        } else {
          // Pure Local Smart Parser (Instant, based on user's actual text!)
          await new Promise(r => setTimeout(r, 350));
          const scriptOutput = smartParseNovelToScript(text, mode);
          document.getElementById('script-output-content').innerText = scriptOutput;
          if (badge) {
            badge.classList.remove('hidden');
            statusText.innerText = `已根据您的小说原文成功生成专属影视剧本！`;
          }
        }

        btnSlice.disabled = false;
        btnText.innerHTML = `<span>🎬 重新运行影视化脱水切片</span>`;

        // Pulse highlight
        if (container) {
          container.classList.add('ring-2', 'ring-blue-400', 'border-blue-400');
          setTimeout(() => {
            container.classList.remove('ring-2', 'ring-blue-400', 'border-blue-400');
          }, 1500);

          if (window.innerWidth < 1024) {
            container.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    }

    // Copy Novel Script Button
    const copyScriptBtn = document.getElementById('btn-copy-script');
    if (copyScriptBtn) {
      copyScriptBtn.addEventListener('click', () => {
        const text = document.getElementById('script-output-content').innerText;
        navigator.clipboard.writeText(text).then(() => {
          const label = document.getElementById('btn-copy-script-label');
          if (label) {
            const old = label.innerText;
            label.innerText = '✅ 剧本已复制！';
            setTimeout(() => {
              label.innerText = old;
            }, 2000);
          }
        });
      });
    }

    // Copy Novel Full DeepSeek-R1 Prompt Button (Embeds the user's actual novel text!)
    const copyNovelPromptBtn = document.getElementById('btn-copy-novel-prompt');
    if (copyNovelPromptBtn) {
      copyNovelPromptBtn.addEventListener('click', () => {
        const rawText = (document.getElementById('novel-input')?.value || '').trim();
        if (!rawText) {
          alert('请先在左侧输入小说内容，或载入示例！');
          return;
        }

        const prompt = `你是一名有10年院线与短剧制作经验的资深编剧总监。请依据我提供的以下小说原文，将其彻底脱水并改编为标准 90 秒一集的微短剧前 3 集完整台本：

【待改编小说原文】：
${rawText}

【10 年编剧正规军写作铁律】：
1. 彻底剥离所有小说的冗余心理描写、书面修辞与叙述旁白，100% 转换为摄像机能拍到的纯物理动作、光影和道具细节；
2. 严格遵循 90 秒四相位节拍：
   - [00:00-00:08 黄金核爆钩子]：0秒绝不空镜，特写视觉奇观或强冲突切入；
   - [00:08-00:35 窒息施压筑底]：对抗升级，封死主角体面退路；
   - [00:35-01:10 微爽反制反弹]：主角气场反杀，局势撬动；
   - [01:10-01:30 终极悬念截断]：靴子落地前半秒强行死卡黑屏，诱导连续付费！
3. 单句台词严禁超过 15 个字，短促有力，具有刺向对方心脏的刀刃感；
4. 输出标准影视剧本格式（场口INT/EXT、场景描写、人物名居中、情绪潜台词提示）。`;

        navigator.clipboard.writeText(prompt).then(() => {
          alert('🤖 已将您的小说原文与《DeepSeek-R1 80集全套指令》打包复制！\n可以直接在 DeepSeek / ChatGPT 对话框中粘贴发送！');
        });
      });
    }

    const copyMatrixBtn = document.getElementById('btn-copy-matrix');
    if (copyMatrixBtn) {
      copyMatrixBtn.addEventListener('click', () => {
        const text = `【角色对立张力卡】
主角表面身份：${document.getElementById('char-protag-job').value}
主角终极欲望：${document.getElementById('char-protag-want').value}
主角致命软肋：${document.getElementById('char-protag-weak').value}
反派垄断权力：${document.getElementById('char-antag-power').value}
反派极端折辱：${document.getElementById('char-antag-action').value}
反派虚伪面具：${document.getElementById('char-antag-mask').value}`;
        navigator.clipboard.writeText(text).then(() => {
          alert('🎭 角色张力卡已复制！');
        });
      });
    }
  </script>
</BaseLayout>
