---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const works = await getCollection('works');
  const sortedWorks = works.sort((a, b) => a.data.order - b.data.order);
  return sortedWorks.map((entry, index) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      prevWork: index > 0 ? sortedWorks[index - 1] : null,
      nextWork: index < sortedWorks.length - 1 ? sortedWorks[index + 1] : null,
    },
  }));
}

const { entry, prevWork, nextWork } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout activePath="/works" title={`${entry.data.title} · 原创商业案头`}>
  <!-- Top Reading Progress Indicator -->
  <div id="read-progress-bar" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-amber-500 to-amber-300 z-50 transition-all duration-150 w-0"></div>

  <article class="pt-10 pb-20 px-4 sm:px-6 max-w-4xl mx-auto">
    <!-- Top Nav Breadcrumbs -->
    <div class="flex items-center justify-between mb-6 text-xs font-mono">
      <a href="/works" class="text-cinema-400 hover:text-amber-400 inline-flex items-center gap-1 transition-colors">
        ← 返回原创手稿与剧本库
      </a>
      <span class="text-cinema-500">
        国家版权认证存证保护
      </span>
    </div>

    <!-- Header info with Poster -->
    <header class="pb-8 border-b border-cinema-800">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        <!-- Poster Thumbnail -->
        {entry.data.poster && (
          <div class="w-full md:w-56 shrink-0 rounded-2xl overflow-hidden shadow-2xl border border-cinema-800 bg-cinema-900 group">
            <img
              src={entry.data.poster}
              alt={entry.data.title}
              class="w-full h-auto object-cover aspect-[3/4] group-hover:scale-102 transition-transform duration-500"
            />
          </div>
        )}

        <!-- Meta and Title -->
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
              {entry.data.track}
            </span>
            <span class="text-xs font-mono text-cinema-300 bg-cinema-900 px-2 py-0.5 rounded border border-cinema-800">
              {entry.data.format} · {entry.data.episodes} 集规格
            </span>
            <span class="text-xs font-mono text-cinema-300 bg-cinema-900 px-2 py-0.5 rounded border border-cinema-800">
              担任: {entry.data.role}
            </span>
            <span class="text-xs text-amber-400/90 font-mono px-2 py-0.5 rounded bg-amber-950/40 border border-amber-500/30">
              {entry.data.status}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-snug literary-serif mb-4">
            {entry.data.title}
          </h1>

          <div class="p-4 rounded-xl bg-cinema-950 border border-cinema-800 text-xs sm:text-sm text-cinema-300 mb-4 leading-relaxed">
            <span class="text-amber-400 font-bold block mb-1 font-mono">一句话故事 (Logline):</span>
            <span>{entry.data.logline}</span>
          </div>

          <div class="p-3 rounded-lg bg-amber-950/20 border border-amber-500/30 text-xs text-amber-300">
            <strong>💡 案头价值：</strong>{entry.data.highlight}
          </div>
        </div>
      </div>
    </header>

    <!-- Markdown Article Content -->
    <div class="prose prose-invert max-w-none mt-10 text-cinema-200 leading-loose space-y-6 text-sm sm:text-base">
      <Content />
    </div>

    <!-- Related Cross-Link Toolbox -->
    <div class="mt-14 p-6 rounded-2xl bg-cinema-900/80 border border-cinema-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1">
        <h4 class="text-sm font-bold text-white flex items-center gap-2">
          <span>🛠️</span> 想要开发同类型商用项目？
        </h4>
        <p class="text-xs text-cinema-400">
          可以在在线工作台一键生成 90 秒黄金分集节拍，或下载同款人物欲望冲突表。
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/studio"
          class="px-3.5 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-bold transition-colors"
        >
          打开创作工作台 ➔
        </a>
        <a
          href="/templates"
          class="px-3.5 py-2 rounded-xl bg-cinema-800 hover:bg-cinema-700 text-cinema-200 text-xs font-medium transition-colors"
        >
          复制脚手架模板
        </a>
      </div>
    </div>

    <!-- Industrial Delivery Process -->
    <div class="mt-8 p-6 rounded-2xl bg-cinema-900 border border-cinema-800">
      <h4 class="text-xs font-mono text-amber-400 font-bold uppercase tracking-wider mb-3">
        📋 正规军商业案头交付规范 (Delivery Specs)
      </h4>
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-cinema-950 border border-cinema-850">
          <div class="text-amber-400 font-mono font-bold mb-1">01 / 知识产权存证</div>
          <p class="text-cinema-400 text-[11px] leading-relaxed">国家版权局与区块链存证双重备案，权属清晰，保障投资排他权益。</p>
        </div>
        <div class="p-3 rounded-xl bg-cinema-950 border border-cinema-850">
          <div class="text-amber-400 font-mono font-bold mb-1">02 / 全案大纲工业卡</div>
          <p class="text-cinema-400 text-[11px] leading-relaxed">包含人物欲望冲突表、主副线交织图、前3集留存设计与全剧付费卡扣。</p>
        </div>
        <div class="p-3 rounded-xl bg-cinema-950 border border-cinema-850">
          <div class="text-amber-400 font-mono font-bold mb-1">03 / 标准拍摄分镜</div>
          <p class="text-cinema-400 text-[11px] leading-relaxed">剔除不可拍摄心理旁白，纯视听动作描写，剧组通告与摄影机位无缝对接。</p>
        </div>
        <div class="p-3 rounded-xl bg-cinema-950 border border-cinema-850">
          <div class="text-amber-400 font-mono font-bold mb-1">04 / 联合监制把关</div>
          <p class="text-cinema-400 text-[11px] leading-relaxed">提供开机剧本围读、主创答疑与剪辑粗剪情绪波形复核服务。</p>
        </div>
      </div>
    </div>

    <!-- Article Footer CTA (Commercial Authorization) -->
    <div class="mt-8 pt-8 border-t border-cinema-800 bg-gradient-to-br from-cinema-900 to-cinema-950 p-6 sm:p-8 rounded-2xl border border-amber-500/30 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
      <div>
        <h4 class="text-white font-bold text-base flex items-center gap-2">
          <span>🔒</span> 项目商业排他授权与全集台本研读
        </h4>
        <p class="text-xs sm:text-sm text-cinema-300 mt-1.5 leading-relaxed">
          《{entry.data.title}》全集完整正文剧本、分集大纲及投拍授权已备案存证。影视出品方、短剧制片人可添加岛主微信 <strong class="text-amber-400 font-mono font-bold select-all">bl-free</strong> 洽谈独家授权、定制约稿或联合出品。
        </p>
      </div>
      <button
        type="button"
        onclick={`window.copyToClipboard('bl-free', '已成功复制微信号【bl-free】！添加时请备注「项目授权-${entry.data.title.replace(/'/g, "\\'")}」。');`}
        class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-cinema-950 font-bold text-xs shrink-0 transition-all shadow-md active:scale-95 cursor-pointer"
      >
        一键复制微信号 (bl-free)
      </button>
    </div>

    <!-- Previous / Next Navigation Strip -->
    <div class="mt-10 pt-6 border-t border-cinema-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-medium">
      {prevWork ? (
        <a
          href={`/works/${prevWork.slug}`}
          class="w-full sm:w-auto p-3 rounded-xl bg-cinema-900 hover:bg-cinema-850 border border-cinema-800 hover:border-amber-500/30 text-cinema-300 hover:text-white transition-all flex items-center gap-2"
        >
          <span class="text-amber-400">←</span>
          <div class="text-left">
            <span class="text-[10px] text-cinema-400 block font-mono">上一部作品</span>
            <span class="font-bold">{prevWork.data.title}</span>
          </div>
        </a>
      ) : (
        <div class="hidden sm:block"></div>
      )}

      <a href="/works" class="text-cinema-400 hover:text-amber-400 font-mono text-center">
        查看全部 4 部案头 ➔
      </a>

      {nextWork ? (
        <a
          href={`/works/${nextWork.slug}`}
          class="w-full sm:w-auto p-3 rounded-xl bg-cinema-900 hover:bg-cinema-850 border border-cinema-800 hover:border-amber-500/30 text-cinema-300 hover:text-white transition-all flex items-center justify-end gap-2 text-right"
        >
          <div class="text-right">
            <span class="text-[10px] text-cinema-400 block font-mono">下一部作品</span>
            <span class="font-bold">{nextWork.data.title}</span>
          </div>
          <span class="text-amber-400">→</span>
        </a>
      ) : (
        <div class="hidden sm:block"></div>
      )}
    </div>
  </article>

  <!-- Reading Progress Script -->
  <script is:inline>
    window.addEventListener('scroll', () => {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
      const bar = document.getElementById('read-progress-bar');
      if (bar) {
        bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      }
    });
  </script>
</BaseLayout>
