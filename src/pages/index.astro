---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadMagnetCard from '../components/LeadMagnetCard.astro';
import ScreenplayBlock from '../components/ScreenplayBlock.astro';
import BeatVisualizer from '../components/BeatVisualizer.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const sortedGuides = guides.sort((a, b) => a.data.order - b.data.order).slice(0, 6);

const teardowns = await getCollection('teardowns');
const featuredTeardowns = teardowns.slice(0, 3);
---

<BaseLayout activePath="/" title="岛主编剧工坊 · 短剧与AI漫剧变现手艺库">
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 px-4 sm:px-6 overflow-hidden border-b border-cinema-800/80">
    <!-- Ambient glowing spotlight -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-amber-500/10 blur-[130px] pointer-events-none rounded-full"></div>

    <div class="max-w-4xl mx-auto text-center relative z-10">
      <!-- Authority Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cinema-900 border border-amber-500/30 text-xs font-mono text-amber-400 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
        <span>10 年职业影视编剧 · 带着正规军手艺降维实战</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15] literary-serif">
        影视正规军手艺 × 短剧商业规则<br />
        <span class="text-amber-400 bg-clip-text">写出能过审、能起量的硬核剧本</span>
      </h1>

      <!-- Value Subtitle -->
      <p class="mt-6 text-base sm:text-xl text-cinema-300 max-w-2xl mx-auto leading-relaxed">
        十年案头沉淀。把影视工业级的结构力学与竖屏短剧的「付费墙力学」严密咬合。不讲三天速成玄学，只拆解有据可循、可精准复现的剧作工程图纸。
      </p>

      <!-- Primary Action CTAs -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/start"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-cinema-950 font-bold text-sm sm:text-base shadow-lg shadow-amber-500/20 active:scale-95 transition-all flex items-center justify-center gap-2"
        >
          <span>🚀</span>
          <span>从 0 到第一个本子 · 新手路径</span>
        </a>
        <a
          href="/guides"
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-cinema-900 hover:bg-cinema-850 text-white font-medium text-sm sm:text-base border border-cinema-700 hover:border-amber-400/40 transition-all flex items-center justify-center gap-2"
        >
          <span>📖</span>
          <span>系统方法论库</span>
        </a>
      </div>

      <!-- Social Proof Strip (Authentic & Professional) -->
      <div class="mt-12 pt-8 border-t border-cinema-850/80 flex flex-wrap items-center justify-center gap-6 sm:gap-12 text-xs sm:text-sm text-cinema-400 font-mono">
        <div class="flex items-center gap-2">
          <span class="text-amber-400 font-bold">10 年</span>
          <span>职业影视剧作内功</span>
        </div>
        <span class="text-cinema-800 hidden sm:inline">|</span>
        <div class="flex items-center gap-2">
          <span class="text-amber-400 font-bold">独门招牌</span>
          <span>付费点剧作学 · 追订率力学</span>
        </div>
        <span class="text-cinema-800 hidden sm:inline">|</span>
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-bold">工程化</span>
          <span>剧本是视听图纸，拒绝文学流水账</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Studio Banner Callout (在线剧作工作台入口) -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 -mt-2 mb-8">
    <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-cinema-900 via-cinema-900 to-amber-950/40 border border-amber-500/30 shadow-2xl relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-left">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/25 text-amber-400 text-xs font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
          <span>⚡ 实操工具 · 纯前端零隐私泄露</span>
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white literary-serif">
          拒绝假大空流水账！体验「岛主在线编剧工作台」
        </h3>
        <p class="text-xs sm:text-sm text-cinema-300 max-w-2xl leading-relaxed">
          基于 10 年院线与短剧正规军四相位节拍系统。支持「90秒黄金分集节拍生成」、「小说转短剧视听脱水切片」与「工业级 DeepSeek/GPT Prompt 一键导出」。
        </p>
      </div>
      <a
        href="/studio"
        class="shrink-0 px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-cinema-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all flex items-center gap-2"
      >
        <span>立即免费体验工作台</span>
        <span>➔</span>
      </a>
    </div>
  </section>

  <!-- Three Master Tracks (三大核心入口) -->
  <section class="py-16 px-4 sm:px-6 max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-xs font-mono uppercase tracking-widest text-amber-400 mb-2">
        THREE PILLARS · 核心支柱
      </h2>
      <p class="text-2xl sm:text-3xl font-bold text-white tracking-tight literary-serif">
        不是流式资讯，而是有据可循的剧作工程库
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Track 1: Guides -->
      <a
        href="/guides"
        class="group p-6 rounded-2xl bg-cinema-900 border border-cinema-800 hover:border-amber-500/50 hover:bg-cinema-850/80 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
            📖
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors mb-2">
            学方法 · 方法论库
          </h3>
          <p class="text-sm text-cinema-400 leading-relaxed">
            按知识主题组织。从单集 90 秒情绪切片、压抑蓄势爆发四步法、黄金前 3 集留存，到 AI 漫剧管线，全套系统讲透。
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-cinema-800/80 flex items-center justify-between text-xs font-medium text-amber-400">
          <span>进入方法论库</span>
          <span class="group-hover:translate-x-1 transition-transform">➔</span>
        </div>
      </a>

      <!-- Track 2: Teardowns -->
      <a
        href="/teardowns"
        class="group p-6 rounded-2xl bg-cinema-900 border border-cinema-800 hover:border-blue-500/50 hover:bg-cinema-850/80 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
            🔬
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-blue-400 transition-colors mb-2">
            拆爆款 · 深度拉片
          </h3>
          <p class="text-sm text-cinema-400 leading-relaxed">
            用编剧眼拆解公认爆款（《无双》《八零后妈》《逃出大英》）。精准定位爽点在第几分钟、钩子埋在哪里，总结 3-5 条明天就能抄的硬核手艺。
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-cinema-800/80 flex items-center justify-between text-xs font-medium text-blue-400">
          <span>查看经典拆解</span>
          <span class="group-hover:translate-x-1 transition-transform">➔</span>
        </div>
      </a>

      <!-- Track 3: Templates -->
      <a
        href="/templates"
        class="group p-6 rounded-2xl bg-cinema-900 border border-cinema-800 hover:border-emerald-500/50 hover:bg-cinema-850/80 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
            🧰
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition-colors mb-2">
            拿模板 · 工具脚手架
          </h3>
          <p class="text-sm text-cinema-400 leading-relaxed">
            提供可直接复制、下载的工业化脚手架：分集断章节奏卡、爽点检查表、人物欲望冲突表、AI 漫剧镜头 Prompt 映射字典。
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-cinema-800/80 flex items-center justify-between text-xs font-medium text-emerald-400">
          <span>下载实用模板</span>
          <span class="group-hover:translate-x-1 transition-transform">➔</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Live Demonstration: Real Screenplay Craft -->
  <section class="py-12 px-4 sm:px-6 max-w-4xl mx-auto">
    <div class="border border-cinema-800 rounded-2xl p-6 sm:p-8 bg-cinema-900/60">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <span class="text-amber-400 text-lg">🖋️</span>
          <h3 class="text-base sm:text-lg font-bold text-white">
            什么是正规军编剧手艺？
          </h3>
        </div>
        <span class="text-xs font-mono text-cinema-400">从台词潜台词到镜头语言</span>
      </div>

      <p class="text-sm text-cinema-300 mb-4 leading-relaxed">
        业余写手写台词，把心里话直接吼出来；职业编剧写台词，<strong class="text-amber-300">字面越平静，底下风暴越烈</strong>。看看下面的标准剧本示范：
      </p>

      <ScreenplayBlock
        sceneHeading="INT. 顾氏宗祠 - 夜 [暴雪]"
        actionText="寒风卷着碎雪撞击棂窗。族长顾廷威端坐高堂，手旁搁着已除名的朱笔族谱。顾淮跪在冰冷青砖上，肩头积雪未化，衣衫单薄。"
        character="顾淮"
        parenthetical="抬起头，眼神平静得像一口古井，嘴角泛起微不可察的嘲弄"
        dialogue="族长，这朱笔抹掉的，只是族谱上的两笔墨；可抹不掉的，是顾家欠我娘的一条命。"
        note="【潜台词剖析】字面上在说族谱与旧账，实则向反派宣告：我已不在乎被逐出宗族，世俗规则约束已失效，接下来将是降维维度的复仇。"
      />

      <BeatVisualizer
        episodeName="爆款微短剧第一集 · 黄金生死卡点"
      />
    </div>
  </section>

  <!-- Featured Real Teardowns Showcase -->
  <section class="py-16 px-4 sm:px-6 max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <h2 class="text-xs font-mono uppercase tracking-widest text-blue-400 mb-2">
          REVERSE ENGINEERING · 深度拉片
        </h2>
        <h3 class="text-2xl font-bold text-white literary-serif">
          现象级爆款真实拆解
        </h3>
      </div>
      <a href="/teardowns" class="text-sm font-medium text-blue-400 hover:text-blue-300 flex items-center gap-1">
        查看全部拉片拆解 ➔
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredTeardowns.map((item) => (
        <a
          href={`/teardowns/${item.slug}`}
          class="group rounded-2xl bg-cinema-900 border border-cinema-800 hover:border-amber-500/50 hover:bg-cinema-850/80 transition-all flex flex-col overflow-hidden shadow-lg hover:shadow-amber-500/10"
        >
          <!-- Poster Container with Overlay -->
          <div class="relative aspect-[3/4] w-full overflow-hidden bg-cinema-950">
            {item.data.poster ? (
              <img
                src={item.data.poster}
                alt={item.data.title}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-4xl bg-cinema-950">
                🎬
              </div>
            )}
            
            <!-- Gradient Overlay for Legibility -->
            <div class="absolute inset-0 bg-gradient-to-t from-cinema-950 via-cinema-950/20 to-transparent"></div>
            
            <!-- Top Tags -->
            <div class="absolute top-3 left-3 right-3 flex items-center justify-between gap-2">
              <span class="text-[11px] font-bold px-2.5 py-1 rounded-md bg-cinema-950/80 text-amber-400 border border-amber-500/30 backdrop-blur-md shadow-sm">
                {item.data.format}
              </span>
              <span class="text-[11px] font-mono px-2 py-1 rounded-md bg-cinema-950/80 text-cinema-300 border border-cinema-800 backdrop-blur-md">
                {item.data.episodesOrDuration}
              </span>
            </div>

            <!-- Bottom Floating Title on Poster -->
            <div class="absolute bottom-3 left-3 right-3">
              <span class="text-[10px] font-mono text-cinema-400 block mb-1">
                {item.data.genre}
              </span>
              <h4 class="text-base sm:text-lg font-bold text-white group-hover:text-amber-400 transition-colors line-clamp-1 literary-serif drop-shadow-md">
                {item.data.title}
              </h4>
            </div>
          </div>

          <!-- Bottom Card Content -->
          <div class="p-4 flex-1 flex flex-col justify-between">
            <div class="p-2.5 rounded-lg bg-cinema-950 text-xs text-cinema-300 border border-cinema-850/80 mb-3">
              <span class="text-amber-400 font-bold block mb-0.5">⚡ 黄金钩子卡点:</span>
              <span class="line-clamp-2 text-[11px] leading-relaxed">{item.data.hookTiming}</span>
            </div>

            <div class="pt-2 border-t border-cinema-800/60 flex items-center justify-between text-xs text-cinema-400">
              <span class="text-emerald-400 font-medium">✓ 附全案视听拆解</span>
              <span class="text-amber-400 font-bold group-hover:translate-x-1 transition-transform">阅读拉片 ➔</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Featured Guides Showcase -->
  <section class="py-12 px-4 sm:px-6 max-w-6xl mx-auto border-t border-cinema-800/60">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <h2 class="text-xs font-mono uppercase tracking-widest text-amber-400 mb-2">
          CURATED ESSENTIALS · 精选手艺
        </h2>
        <h3 class="text-2xl font-bold text-white literary-serif">
          方法论必读精选
        </h3>
      </div>
      <a href="/guides" class="text-sm font-medium text-amber-400 hover:text-amber-300 flex items-center gap-1">
        查看全部方法论 ➔
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {sortedGuides.map((guide) => (
        <a
          href={`/guides/${guide.slug}`}
          class="p-5 rounded-xl bg-cinema-900 border border-cinema-800 hover:border-cinema-700 hover:bg-cinema-850 transition-all flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
                {guide.data.topic}
              </span>
              <span class="text-[11px] text-cinema-400 font-mono">
                {guide.data.level} · {guide.data.readTime}
              </span>
            </div>
            <h4 class="text-base font-bold text-white hover:text-amber-400 transition-colors line-clamp-2">
              {guide.data.title}
            </h4>
            <p class="mt-2 text-xs text-cinema-300 line-clamp-2 leading-relaxed">
              {guide.data.summary}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-cinema-800/60 flex items-center justify-between text-xs text-cinema-400">
            <span>更新于 {guide.data.updated}</span>
            <span class="text-amber-400">阅读全文 ➔</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Lead Magnet Conversion Section -->
  <section class="py-12 px-4 sm:px-6 max-w-4xl mx-auto">
    <LeadMagnetCard />
  </section>
</BaseLayout>
